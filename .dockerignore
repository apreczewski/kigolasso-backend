# ============================================
# Docker Ignore File for Kigolasso Backend
# Reduces image size by excluding unnecessary files
# ============================================

# Node modules (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment files (use container env vars)
.env
.env.*
!.env.example

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
*.test.ts
*.spec.ts
__tests__/
__mocks__/

# Documentation
*.md
!README.md
docs/
dev-logs/

# CI/CD
.github/
.husky/
.gitlab-ci.yml

# Miscellaneous
*.log
logs/
tmp/
temp/
.cache/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Prisma
prisma/migrations/
prisma/dev.db*

# Scripts
scripts/
